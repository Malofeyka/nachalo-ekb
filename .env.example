# ========================================
# Образовательный центр «Начало»
# Переменные окружения (.env.example)
# Скопируйте этот файл в .env и заполните реальными значениями
# ========================================

# ----------------------------------------
# 1. Настройки базы данных MySQL (Reg.ru / Production)
# ----------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=u3475599_nachalo_db

# ----------------------------------------
# 2. Настройки безопасности & Администратора
# ----------------------------------------
# Секретный ключ для сессий и CSRF защиты (сгенерируйте случайный ключ для продакшена)
SECRET_KEY=

# Логин и Пароль администратора для входа в панель управления (/admin/login/)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ----------------------------------------
# 3. Настройки почты (SMTP отправка заявок)
# ----------------------------------------
MAIL_SERVER=smtp.yandex.ru
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USERNAME=your-email@yandex.ru
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=your-email@yandex.ru
ADMIN_EMAIL=

# ----------------------------------------
# 4. Интеграция с CRM AMAkids (Платформа передача заявок)
# ----------------------------------------
AMAKIDS_APP_CODE=6
AMAKIDS_KEY=
AMAKIDS_FRANCH_ID=
AMAKIDS_API_URL=https://kidsplatform.ru/api/add_lead_post
